Replicaset
------------
rs.yaml

---

apiVersion: apps/v1
kind: ReplicaSet
metadata:
  name: webrs
  labels:
    app: samplewebrs
    tier: webrs
spec:
  # modify replicas according to your case
  replicas: 3
  selector:
    matchLabels:
      tier: webrs
  template:
    metadata:
      labels:
        tier: webrs
    spec:
      containers:
      - name: webrs
        image: dockerpandian/httpd:latest
        ports:
          - contianers: 80

kubectl apply -f rs.yaml          

kubectl get pods

kubectl delete pod <pod_name>

kubectl scale rs webrs --replicas=5

kubectl scale rs webrs --replicas=1

