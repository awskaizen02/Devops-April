create a manifes with pod + service + namesapce

2.yaml

---
apiVersion: v1
kind: Namespace
metadata:
  name: kaizenns

---
apiVersion: v1
kind: Pod
metadata:
  name: javawebapppod
  namespace: kaizenns
  labels:
    app: javawebapppod
spec:
  containers:
    - name: demojava
      image: dockerpandian/httpd:latest
      ports:
        - contianerPort: 80

---
apiVersion: v1
kind: service
metadata:
  name: javasvc
  namespace: kaizenns
spec:
  type: NodePort
  selector:
  app: javawebapp
ports:
  - port: 80
    targetPort: 8080
    nodePort: 30070   
    
kubectl apply -f 2.yaml

kubectl get pods -n kaizenns // check all ponds in kaizenns

kubectl get svc -n kaizenns  // check service in kaizenns

kubectl get all -n kaizenns  // check all resources

